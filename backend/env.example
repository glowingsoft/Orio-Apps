# Yazeen backend — environment template (no secrets).
# Copy to backend/.env and fill in the values for the environment you are setting up:
#   cp backend/env.example backend/.env
# Production, staging and local each have their OWN .env with their own database,
# storage bucket and secrets. Never copy production secrets into staging or local.

# ============================================================================
# Required
# ============================================================================

# MongoDB connection string (Atlas: Database → Connect → Drivers). Use a dedicated
# database user with readWrite on this database only; Atlas connections are TLS.
#   production : mongodb+srv://<user>:<password>@<prod-cluster>/?retryWrites=true&w=majority
#   staging    : mongodb+srv://<user>:<password>@<staging-cluster>/?retryWrites=true&w=majority
#   local      : mongodb://localhost:27017
MONGO_URL=mongodb://localhost:27017
# Existing production data lives in the "orio" database (name kept from before the rebrand).
DB_NAME=orio

# JWT signing secrets — long random strings, different per environment.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_SECRET=change-me
REFRESH_SECRET=change-me
ACCESS_MINUTES=60
REFRESH_DAYS=30

# Port uvicorn listens on (nginx proxies /api to it).
PORT=8000

# Browser origins allowed to call the API (comma-separated).
#   production : https://aazabex.com,https://www.aazabex.com
#   staging    : https://staging.aazabex.com
# Local dev (localhost / LAN IPs) is allowed by CORS_ORIGIN_REGEX's default.
CORS_ORIGINS=https://aazabex.com,https://www.aazabex.com
# CORS_ORIGIN_REGEX=

# ============================================================================
# Media storage (AWS S3)
# ============================================================================
# One bucket per environment. On EC2 prefer an IAM instance role over access keys.
S3_BUCKET=
AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Folder for chunked uploads in progress (must be writable by the service user).
UPLOAD_TMP_DIR=/var/lib/orio/uploads

# ============================================================================
# Firebase (Google Sign-In verification + push notifications)
# ============================================================================
# Service-account key file: kept OUT of git. On the server the deploy writes it from the
# FIREBASE_SERVICE_ACCOUNT GitHub secret (chmod 600).
PUSH_PROVIDER=firebase
FIREBASE_SERVICE_ACCOUNT_PATH=service-account.json
FIREBASE_PROJECT_ID=orio-4d359

# ============================================================================
# Voice rooms and calls (Agora)
# ============================================================================
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ============================================================================
# Admin dashboard
# ============================================================================
# The owner account (full admin rights). Set to the company owner's email.
ADMIN_OWNER_EMAIL=owner@example.com

# ============================================================================
# Wallet / payments
# ============================================================================
# Unpaid "test" Diamond top-ups. MUST be false in production (anyone could top up free).
TEST_RECHARGE_ENABLED=false
PAYMENTS_ENABLED=false
# STRIPE_API_KEY=

# ============================================================================
# Optional sign-in providers
# ============================================================================
# Apple Sign In — comma-separated audiences / client IDs
# APPLE_AUDIENCES=com.aazabex.yazeen
# Twilio phone OTP
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# Facebook login
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
