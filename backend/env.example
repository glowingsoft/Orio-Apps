# ORIO backend — copy to backend/.env
#   cp backend/env.example backend/.env

# ---- Required ----
# Use 27017 if your Mongo has no auth.
# Use 27018 if you started a local no-auth mongod for this project.
MONGO_URL=mongodb://localhost:27018
DB_NAME=orio

# JWT secrets — change for anything beyond local play
ACCESS_SECRET=dev-access-secret-change-me
REFRESH_SECRET=dev-refresh-secret-change-me

# Token lifetimes
ACCESS_MINUTES=60
REFRESH_DAYS=30

# ---- Optional (local defaults) ----
TEST_RECHARGE_ENABLED=true
PAYMENTS_ENABLED=false

# Stripe (only if PAYMENTS_ENABLED=true and emergentintegrations is installed)
# STRIPE_API_KEY=sk_test_...

# Media storage — set S3_BUCKET to store uploads in S3 (otherwise Emergent storage is used)
# S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Local staging dir for chunked uploads (must be writable by the service user)
# UPLOAD_TMP_DIR=/var/lib/orio/uploads

# Agora — real voice rooms / RTC
# AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=

# Apple Sign In — comma-separated audiences / client IDs
# APPLE_AUDIENCES=com.oriotechnology.orio

# Twilio phone OTP
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# Facebook login
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Admin dashboard owner
ADMIN_OWNER_EMAIL=orioowner@gmail.com

# Emergent integrations (media / push) — optional for local
# EMERGENT_LLM_KEY=
# EMERGENT_PUSH_KEY=placeholder
# INTEGRATION_PROXY_URL=https://integrations.emergentagent.com
