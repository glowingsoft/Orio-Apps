# ORIO frontend — copy to frontend/.env
#   cp frontend/env.example frontend/.env
#
# Restart Expo after changing this file.

# Backend base URL (no trailing slash, no /api)
# Simulator / web on same machine:
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Physical device on same Wi‑Fi — use your computer's LAN IP instead:
# EXPO_PUBLIC_BACKEND_URL=http://192.168.1.20:8000

# Firebase web app "ORIO Web" (Google Sign-In on the website).
# Firebase Console → Project settings → General → Your apps → ORIO Web → SDK setup and configuration → Config.
# These are public client values (they ship in the web bundle); never put a service-account key here.
EXPO_PUBLIC_FIREBASE_API_KEY=your-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=orio-4d359.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=orio-4d359
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-storage-bucket
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-web-app-id

# Google Sign-In on Android/iOS: the "Web client" OAuth ID (google-services.json, client_type 3).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
