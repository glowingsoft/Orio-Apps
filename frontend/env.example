# ORIO frontend — copy to frontend/.env
#   cp frontend/env.example frontend/.env
#
# Restart Expo after changing this file.

# Backend base URL (no trailing slash, no /api)
# Simulator / web on same machine:
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Physical device on same Wi‑Fi — use your computer's LAN IP instead:
# EXPO_PUBLIC_BACKEND_URL=http://192.168.1.20:8000
