{
  "expo": {
    "name": "Yazeen",
    "slug": "yazeen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aazabex.yazeen",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Yazeen uses your mic for voice rooms, calls and voice messages.",
        "NSPhotoLibraryUsageDescription": "Pick a profile photo from your gallery",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSCameraUsageDescription": "Take photos to send in private chats",
        "NSAppleMusicUsageDescription": "Play your songs in Yazeen rooms"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.aazabex.yazeen",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-audio",
        {
          "microphonePermission": "Yazeen uses your mic for voice rooms and mic seats."
        }
      ],
      "expo-asset",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick photos to share in chats and posts",
          "cameraPermission": "Take photos to send in private chats"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "enablePngCrunchInReleaseBuilds": true,
            "useLegacyPackaging": false,
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      "./plugins/withAgoraSlim",
      [
        "expo-media-library",
        {
          "photosPermission": "Pick photos to share in Yazeen",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "audio",
            "photo"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "49cf9f56-9faf-4c6a-be31-f3f8c88e9095"
      }
    },
    "owner": "aazabex"
  }
}
